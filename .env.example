# Klassen-Blog Konfiguration
# Kopiere diese Datei als ".env" und passe die Werte an.
# (Benötigt das Paket "dotenv" – oder setze Variablen direkt in deinem Terminal.)

# Port, auf dem der Server läuft (Standard: 3000)
PORT=3000

# Geheimer URL-Pfad für Schülerinnen und Schüler
# Beispiel: http://localhost:3000/klasse10d-xk92m
STUDENT_PATH=klasse10d-xk92m

# Geheimer URL-Pfad für den Admin-Bereich (Lehrperson)
# Beispiel: http://localhost:3000/lehrer-admin-xk92m
ADMIN_PATH=lehrer-admin-xk92m

# Beiträge erst nach Admin-Freigabe veröffentlichen?
# Setze auf "true" für moderierte Veröffentlichung, "false" für sofortige Anzeige
REQUIRE_APPROVAL=false
